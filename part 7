<script>

function calculateTotal(){

let product = document.getElementById("product").value;
let quantity = document.getElementById("quantity").value;
let delivery = document.getElementById("delivery").value;


let price = 0;


if(product=="heart"){
price=10;
}

else if(product=="tablet"){
price=40;
}

else if(product=="love"){
price=50;
}

else if(product=="cakesicle"){
price=60;
}

else if(product=="100g"){
price=200;
}

else if(product=="custom"){
price=250;
}


let deliveryCharge = 0;


if(delivery=="inside"){
deliveryCharge=50;
}

else if(delivery=="outside"){
deliveryCharge=100;
}


let total = (price * quantity) + deliveryCharge;


document.getElementById("total").innerHTML =
"Total: ৳" + total;

}

</script>
<button type="button" onclick="sendOrder()">
Send Order to Facebook
</button>
<script>

function sendOrder(){

let product = document.getElementById("product").value;
let quantity = document.getElementById("quantity").value;
let delivery = document.getElementById("delivery").value;
let name = document.querySelector('input[placeholder="Your Name"]').value;
let phone = document.querySelector('input[placeholder="Phone Number"]').value;
let address = document.querySelector('textarea').value;


let message = 
"🍫 Choco Whimsy By Lamiya Order\n\n" +
"Product: " + product +
"\nQuantity: " + quantity +
"\nDelivery: " + delivery +
"\nName: " + name +
"\nPhone: " + phone +
"\nAddress: " + address;


navigator.clipboard.writeText(message);


alert("Order details copied! এখন Facebook Page এ গিয়ে Message করুন।");


window.open(
"https://facebook.com/yourpage",
"_blank"
);

}

</script>
